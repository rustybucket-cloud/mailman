{
  "name": "mailman",
  "version": "0.1.0",
  "private": true,
  "description": "Drafts app release notes with Claude Code from your GitHub history, then delivers them as a pull request for approval.",
  "main": "./out/main/index.js",
  "author": "Jacob Patton",
  "license": "MIT",
  "repository": "github:rustybucket-cloud/mailman",
  "homepage": "https://github.com/rustybucket-cloud/mailman",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "dev.mailman.app",
    "productName": "Mailman",
    "files": [
      "out/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "zod": "^4.6.6"
  }
}
